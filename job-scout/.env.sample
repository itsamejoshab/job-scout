# Shared DB
POSTGRES_USER=job
POSTGRES_PASSWORD=applicant
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=jobsearch

# Temporal + API
TEMPORAL_ADDRESS=temporal:7233
API_PORT=8000

# Notify webhook: POST WEBHOOK_BASE with JSON {"notify": WEBHOOK_ID, "message": "..."}.
# WEBHOOK_URL is unused and is not the send target. Do not commit real URLs or secrets.
WEBHOOK_BASE=https://hooks.example/api/webhook
WEBHOOK_ID=example-hook

# OAuth client credentials for the webhook. Empty skips the token request.
CLIENT_ID=
CLIENT_SECRET=

# Temporal interval schedules (UTC, overlap skip)
SCRAPE_SCHEDULE_SECONDS=60
NOTIFY_SCHEDULE_SECONDS=300

# Scrape / notify knobs
SCRAPE_ERROR_BACKOFF_SECONDS=300
NOTIFY_MAX_JOBS=25
NOTIFY_CLAIM_TIMEOUT_SECONDS=0
HTTP_TIMEOUT_SECONDS=30
