# Shared DB
POSTGRES_USER=job
POSTGRES_PASSWORD=applicant
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=jobsearch

# Temporal + API
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_UI_ADDRESS=http://localhost:8082
# Optional compose image pins (set in repo-root .env for docker compose):
# TEMPORAL_VERSION=1.29.2
# TEMPORAL_UI_VERSION=2.42.1
REPORTING_TIMEZONE=America/New_York
API_PORT=8000

# Pipedream notification webhook (optional). Leave blank to disable delivery.
# When set, POST WEBHOOK_BASE with JSON {"notify": WEBHOOK_ID, "message": "..."}.
# WEBHOOK_URL is unused and is not the send target. Do not commit real URLs or secrets.
# You can also turn notifications off in Settings while keeping these values set.
WEBHOOK_BASE=
WEBHOOK_ID=

# Optional static webhook token. Sent as Authorization: Bearer <token>. Empty skips the header.
PIPEDREAM_API_TOKEN=

# Temporal schedules (America/New_York, overlap skip).
# Integer products such as 60*10 are allowed for scrape (600 seconds).
# Notify cron is minute hour day month weekday in REPORTING_TIMEZONE.
SCRAPE_SCHEDULE_SECONDS=600
NOTIFY_CRON=39 7,17,20 * * *

# Scrape / notify knobs
# Set to 1 for query and alert diagnostics on container stdout.
DEBUG=0
SCRAPE_ERROR_BACKOFF_SECONDS=300
NOTIFY_MAX_JOBS=25
NOTIFY_CLAIM_TIMEOUT_SECONDS=900
HTTP_TIMEOUT_SECONDS=30

# Apify (Dice and Indeed). Empty token skips Apify scrapers. Do not commit real tokens.
APIFY_API_TOKEN=
APIFY_MONTHLY_BUDGET_USD=1.00
