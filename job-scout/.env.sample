# Shared DB
POSTGRES_USER=job
POSTGRES_PASSWORD=applicant
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=jobsearch

# Temporal + API
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_UI_ADDRESS=http://localhost:8082
REPORTING_TIMEZONE=America/New_York
API_PORT=8000

# Notify webhook: POST WEBHOOK_BASE with JSON {"notify": WEBHOOK_ID, "message": "..."}.
# WEBHOOK_URL is unused and is not the send target. Do not commit real URLs or secrets.
WEBHOOK_BASE=https://hooks.example/api/webhook
WEBHOOK_ID=example-hook

# Static webhook token. Sent as Authorization: Bearer <token>. Empty skips the header.
PIPEDREAM_API_TOKEN=

# Temporal schedules (REPORTING_TIMEZONE, overlap skip).
# Integer products such as 60*10 are allowed (600 seconds).
# Notify offset is seconds after each interval start (540 = minute 9 of each 10 minutes).
# Notify skip calendars keep runs inside NOTIFY_ACTIVE_START..NOTIFY_ACTIVE_END.
SCRAPE_SCHEDULE_SECONDS=600
NOTIFY_SCHEDULE_SECONDS=600
NOTIFY_SCHEDULE_OFFSET_SECONDS=540
NOTIFY_ACTIVE_START=07:30
NOTIFY_ACTIVE_END=21:00

# Scrape / notify knobs
# Set to 1 for query and alert diagnostics on container stdout.
DEBUG=0
SCRAPE_ERROR_BACKOFF_SECONDS=300
NOTIFY_MAX_JOBS=25
NOTIFY_CLAIM_TIMEOUT_SECONDS=0
HTTP_TIMEOUT_SECONDS=30
